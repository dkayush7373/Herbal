# Base URL of the website
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp business number for direct ordering and checkout (E.164 without +, digits only, e.g. 919876543210).
# Leave blank during initial setup; checkout & WhatsApp FAB will hide gracefully until set.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Endpoint for newsletter subscriptions
NEXT_PUBLIC_NEWSLETTER_ENDPOINT=

# Set to "true" to display sample reviews before production reviews are collected
NEXT_PUBLIC_SHOW_DEMO_CONTENT=false

# Brand Social Media Handles / URLs
NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://instagram.com
NEXT_PUBLIC_SOCIAL_FACEBOOK=https://facebook.com
NEXT_PUBLIC_SOCIAL_X=https://x.com
NEXT_PUBLIC_SOCIAL_YOUTUBE=https://youtube.com
